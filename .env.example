# Ejemplo de PRODUCCIÓN. Copiar fuera del repositorio; no contiene secretos.
COMPOSE_PROJECT_NAME=mcp-agent
MCP_DOMAIN=agent.example.com
MCP_PROXY_NETWORK=proxy
MCP_DATA_NETWORK=shared-services
MCP_TRAEFIK_ENTRYPOINT=websecure
MCP_TRAEFIK_RESOLVER=letsencrypt
MCP_RUNTIME_SECRETS_DIR=/srv/mcp-agent/runtime-secrets
MCP_MIGRATION_DATABASE_URL_PATH=/srv/mcp-agent/migration-database-url
# Opcional: archivo dentro del directorio runtime-secrets montado en el contenedor.
# MCP_REDIS_URL_FILE=/run/mcp-config/redis-url
